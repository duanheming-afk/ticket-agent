API_HOST=127.0.0.1
API_PORT=8010
LLM_HOST=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b

# 配置真实交通 API 后，对应交通方式会自动使用 HTTP Provider；留空时使用本地 Mock 数据。
TRAIN_PROVIDER_URL=
FLIGHT_PROVIDER_URL=
TAXI_PROVIDER_URL=
TRAIN_PROVIDER_API_KEY=
FLIGHT_PROVIDER_API_KEY=
TAXI_PROVIDER_API_KEY=
TRAIN_PROVIDER_ITEMS_PATH=
FLIGHT_PROVIDER_ITEMS_PATH=
TAXI_PROVIDER_ITEMS_PATH=

# Amadeus 航班真实 Provider（先在官方开发者平台创建 App，再填写两个凭据）
# true 时优先使用 Amadeus；false 或留空时航班继续使用上面的通用 Provider/本地 Mock。
AMADEUS_ENABLED=false
AMADEUS_BASE_URL=https://test.api.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Provider 可靠性配置
PROVIDER_TIMEOUT_SECONDS=8
PROVIDER_MAX_RETRIES=2
PROVIDER_FAILURE_THRESHOLD=3
PROVIDER_COOLDOWN_SECONDS=30
